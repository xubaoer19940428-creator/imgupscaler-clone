# Reuse the API origin and login token conventions from artguru-clone.
NEXT_PUBLIC_ARTGURU_API_BASE_URL=https://api.mixu.ai

# Optional ImgUpscaler-specific aliases. The API adapter accepts either name.
NEXT_PUBLIC_IMGUPSCALER_API_BASE_URL=
NEXT_PUBLIC_IMGUPSCALER_API_TOKEN=
NEXT_PUBLIC_ARTGURU_APP_SECRET_KEY=
NEXT_PUBLIC_IMGUPSCALER_APP_SECRET_KEY=

# Upscale and Enhance use google/nano-banana-pro in the adapter; only Reimagine is configurable here.
NEXT_PUBLIC_IMGUPSCALER_REIMAGINE_MODEL=openai/gpt-image-1
NEXT_PUBLIC_IMGUPSCALER_REIMAGINE_OPERATION=transforms
