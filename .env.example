# Reuse the API origin and login token conventions from artguru-clone.
NEXT_PUBLIC_ARTGURU_API_BASE_URL=https://api.example.com
NEXT_PUBLIC_ARTGURU_API_ENABLED=false

# Optional ImgUpscaler-specific aliases. The API adapter accepts either name.
NEXT_PUBLIC_IMGUPSCALER_API_BASE_URL=
NEXT_PUBLIC_IMGUPSCALER_API_ENABLED=false
NEXT_PUBLIC_IMGUPSCALER_API_TOKEN=

# AIController image models. Defaults to openai/gpt-image-1 when omitted.
NEXT_PUBLIC_IMGUPSCALER_UPSCALER_MODEL=openai/gpt-image-1
NEXT_PUBLIC_IMGUPSCALER_ENHANCER_MODEL=openai/gpt-image-1
NEXT_PUBLIC_IMGUPSCALER_REIMAGINE_MODEL=openai/gpt-image-1
NEXT_PUBLIC_IMGUPSCALER_UPSCALER_OPERATION=upscales
NEXT_PUBLIC_IMGUPSCALER_ENHANCER_OPERATION=upscales
NEXT_PUBLIC_IMGUPSCALER_REIMAGINE_OPERATION=transforms
