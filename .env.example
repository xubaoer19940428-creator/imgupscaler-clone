# Canonical public origin for canonical URLs, hreflang, sitemap, and social previews.
# Production: use https://photosharp.app. photoupscale.app and photopop.app are
# aliases and are redirected to this canonical origin by proxy.ts.
# Leave empty for local previews; indexing is disabled until this is set.
NEXT_PUBLIC_SITE_URL=https://photosharp.app

# Reuse the API origin and login token conventions from artguru-clone.
NEXT_PUBLIC_ARTGURU_API_BASE_URL=https://api.mixu.ai
NEXT_PUBLIC_ACCEPT_DOMAIN=photopop.app

# Optional PhotoSharp-specific aliases. The API adapter accepts either name.
NEXT_PUBLIC_IMGUPSCALER_API_BASE_URL=
NEXT_PUBLIC_IMGUPSCALER_API_TOKEN=
NEXT_PUBLIC_ARTGURU_APP_SECRET_KEY=
NEXT_PUBLIC_IMGUPSCALER_APP_SECRET_KEY=

# The adapter defaults to the active catalog models. Override these only when
# the API deployment for a domain uses a different model or operation.
NEXT_PUBLIC_IMGUPSCALER_UPSCALE_MODEL=google/upscaler
NEXT_PUBLIC_IMGUPSCALER_UPSCALE_OPERATION=upscales
NEXT_PUBLIC_IMGUPSCALER_ENHANCER_MODEL=topazlabs/image-upscale
NEXT_PUBLIC_IMGUPSCALER_ENHANCER_OPERATION=upscales
NEXT_PUBLIC_IMGUPSCALER_REIMAGINE_MODEL=google/nano-banana-pro
NEXT_PUBLIC_IMGUPSCALER_REIMAGINE_OPERATION=generations
